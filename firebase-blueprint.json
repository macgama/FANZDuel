{
  "entities": {
    "User": {
      "title": "User",
      "description": "The player's profile and game state.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "pseudo": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "favoriteTeams": { "type": "array", "items": { "type": "string" } },
        "money": { "type": "number", "description": "Game currency ($)" },
        "gems": { "type": "number", "description": "Rare currency" },
        "boostPoints": { "type": "number" },
        "energy": { "type": "number", "description": "Renewable resource (max 100)" },
        "lastEnergyRefill": { "type": "string", "format": "date-time" },
        "ferveurPoints": { "type": "number" },
        "level": { "type": "number", "description": "1 to 15" },
        "teamSlots": { "type": "number", "default": 2 },
        "cards": { "type": "array", "items": { "type": "string" } },
        "skins": { "type": "array", "items": { "type": "string" } },
        "emotes": { "type": "array", "items": { "type": "string" } },
        "role": { "type": "string", "enum": ["admin", "moderator", "client"], "default": "client" },
        "language": { "type": "string", "default": "fr" },
        "streak": { "type": "number", "default": 0 },
        "lastLoginDate": { "type": "string" },
        "claimedStreakDays": { "type": "array", "items": { "type": "number" } },
        "passId": { "type": "string" },
        "passPoints": { "type": "number", "default": 0 },
        "isPassPremium": { "type": "boolean", "default": false },
        "claimedPassRewards": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "pseudo", "email", "money", "gems", "boostPoints", "energy", "ferveurPoints", "level", "role"]
    },
    "Fanz": {
      "title": "Fanz",
      "description": "A character used for duels.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "templateId": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "sport": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "force": { "type": "number" },
            "endurance": { "type": "number" },
            "mental": { "type": "number" },
            "bluff": { "type": "number" },
            "creativity": { "type": "number" },
            "social": { "type": "number" },
            "intelligence": { "type": "number" },
            "charisma": { "type": "number" }
          }
        },
        "xp": { "type": "number" },
        "level": { "type": "number", "description": "1 to 5" },
        "ferveurPoints": { "type": "number" },
        "ferveurLevel": { "type": "number", "description": "1 to 5" },
        "energy": { "type": "number" },
        "equippedCards": { "type": "array", "items": { "type": "string" } },
        "unlockedSkins": { "type": "array", "items": { "type": "string" } },
        "equippedSkin": { "type": "string" },
        "unlockedEmotes": { "type": "array", "items": { "type": "string" } },
        "rank": { "type": "number", "description": "1 to 10, paid with Money/Boosts" },
        "claimedRewards": { "type": "array", "items": { "type": "string" } }
      }
    },
    "FanzTemplate": {
      "title": "FanzTemplate",
      "description": "A template for a Fanz character.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sport": { "type": "string" },
        "rarity": { "type": "string", "enum": ["common", "rare", "epic", "legendary"] },
        "image": { "type": "string" },
        "video": { "type": "string" },
        "description": { "type": "string" },
        "baseStats": { "type": "object" },
        "specialCards": { "type": "array", "items": { "type": "string" } },
        "skins": { "type": "array" },
        "emotes": { "type": "array" },
        "ferveurPath": { "type": "array" },
        "rankRewards": { "type": "object" }
      },
      "required": ["id", "name", "sport", "rarity", "image", "description", "baseStats"]
    },
    "Duel": {
      "title": "Duel",
      "description": "A real-time match between fans.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["training", "1v1", "2v2", "5v5", "war_of_kops"] },
        "status": { "type": "string", "enum": ["waiting", "active", "finished"] },
        "matchId": { "type": "string", "description": "ID from api-football if applicable" },
        "teamA": { "type": "string" },
        "teamB": { "type": "string" },
        "progress": { "type": "number", "description": "0 to 100 (tug of war)" },
        "participants": { "type": "array" },
        "scores": { "type": "object" }
      }
    },
    "TeamFerveur": {
      "title": "TeamFerveur",
      "description": "Aggregated ferveur for a club or national team.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "name": { "type": "string" },
        "totalFerveur": { "type": "number" },
        "userCount": { "type": "number" },
        "averageFerveur": { "type": "number" }
      }
    },
    "League": {
      "title": "League",
      "description": "Football league/competition data from API",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "logo": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "countryFlag": { "type": "string" },
        "season": { "type": "number" }
      },
      "required": ["id", "name", "country", "season"]
    },
    "Team": {
      "title": "Team",
      "description": "Football team data from API",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "country": { "type": "string" },
        "founded": { "type": "number" },
        "logo": { "type": "string" },
        "venue": { "type": "object" }
      },
      "required": ["id", "name", "logo"]
    },
    "Standing": {
      "title": "Standing",
      "description": "League standings from API",
      "type": "object",
      "properties": {
        "rank": { "type": "number" },
        "teamId": { "type": "number" },
        "points": { "type": "number" },
        "goalsDiff": { "type": "number" },
        "group": { "type": "string" },
        "form": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "all": { "type": "object" },
        "home": { "type": "object" },
        "away": { "type": "object" },
        "update": { "type": "string" },
        "season": { "type": "number" }
      },
      "required": ["rank", "teamId", "points", "season"]
    },
    "LifeAction": {
      "title": "LifeAction",
      "description": "A life action that a Fanz can perform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fanzTemplateId": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" },
        "videoUrl": { "type": "string" },
        "targetStat": { "type": "string" },
        "xpGain": { "type": "number" },
        "energyCost": { "type": "number" },
        "moneyCost": { "type": "number" },
        "gemsCost": { "type": "number" },
        "boostCost": { "type": "number" },
        "energyGain": { "type": "number" },
        "moneyGain": { "type": "number" },
        "gemsGain": { "type": "number" },
        "boostGain": { "type": "number" },
        "xpGains": { "type": "object" },
        "durationMinutes": { "type": "number" }
      },
      "required": ["id", "fanzTemplateId", "name", "durationMinutes"]
    },
    "Fixture": {
      "title": "Fixture",
      "description": "Match fixture data from API",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "referee": { "type": "string" },
        "timezone": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" },
        "periods": { "type": "object" },
        "venue": { "type": "object" },
        "status": { "type": "object" },
        "league": { "type": "object" },
        "teams": { "type": "object" },
        "goals": { "type": "object" },
        "score": { "type": "object" },
        "season": { "type": "number" }
      },
      "required": ["id", "date", "teams", "season"]
    },
    "Card": {
      "title": "Card",
      "description": "A template for a duel card.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["bonus", "malus", "neutral"] },
        "rarity": { "type": "string", "enum": ["common", "rare", "epic", "legendary"] },
        "energyCost": { "type": "number" },
        "description": { "type": "string" },
        "effects": { "type": "array" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "fanzIds": { "type": "array", "items": { "type": "string" } },
        "unlockRequirements": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "name", "type", "rarity", "energyCost"]
    },
    "UserCard": {
      "title": "UserCard",
      "description": "A user's instance of a card with level and XP.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The card template ID" },
        "ownerUid": { "type": "string" },
        "level": { "type": "number", "minimum": 1, "maximum": 5 },
        "xp": { "type": "number" }
      },
      "required": ["id", "ownerUid", "level", "xp"]
    },
    "Mission": {
      "title": "Mission",
      "description": "A mission for users to complete.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["duel", "action", "social", "collection"] },
        "targetValue": { "type": "number" },
        "reward": { "type": "object" },
        "isActive": { "type": "boolean" }
      }
    },
    "Pass": {
      "title": "Pass",
      "description": "A seasonal pass (e.g., World Cup Pass).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "levels": { "type": "array" },
        "premiumPrice": { "type": "object" }
      }
    },
    "GlobalFervorConfig": {
      "title": "GlobalFervorConfig",
      "description": "Global fervor path configuration for users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "levels": { "type": "array" }
      }
    },
    "WeeklyStreakConfig": {
      "title": "WeeklyStreakConfig",
      "description": "Configuration for daily login rewards.",
      "type": "object",
      "properties": {
        "day": { "type": "number" },
        "reward": { "type": "object" }
      }
    },
    "MatchScore": {
      "title": "MatchScore",
      "description": "Score of a duel associated with a real match.",
      "type": "object",
      "properties": {
        "matchId": { "type": "string" },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "User profiles" },
    "/fanz/{fanzId}": { "schema": "Fanz", "description": "Characters owned by users" },
    "/fanz_templates/{templateId}": { "schema": "FanzTemplate", "description": "Fanz templates" },
    "/life_actions/{actionId}": { "schema": "LifeAction", "description": "Life actions available for Fanz" },
    "/duels/{duelId}": { "schema": "Duel", "description": "Active and past duels" },
    "/teams/{teamId}": { "schema": "TeamFerveur", "description": "Team ferveur rankings" },
    "/leagues/{leagueId}": { "schema": "League", "description": "Imported football leagues" },
    "/api_teams/{teamId}": { "schema": "Team", "description": "Imported football teams from API" },
    "/leagues/{leagueId}/seasons/{season}/standings/{standingId}": { "schema": "Standing", "description": "Standings for a specific league and season" },
    "/leagues/{leagueId}/seasons/{season}/fixtures/{fixtureId}": { "schema": "Fixture", "description": "Fixtures for a specific league and season" },
    "/leagues/{leagueId}/seasons/{season}/teams/{teamId}": { "schema": "Team", "description": "Teams for a specific league and season" },
    "/cards/{cardId}": { "schema": "Card", "description": "Card templates" },
    "/users/{uid}/user_cards/{cardId}": { "schema": "UserCard", "description": "User's card instances with level/XP" },
    "/missions/{missionId}": { "schema": "Mission", "description": "Global missions" },
    "/passes/{passId}": { "schema": "Pass", "description": "Seasonal passes" },
    "/global_configs/user_fervor": { "schema": "GlobalFervorConfig", "description": "Global user fervor path" },
    "/weekly_streak_config/{day}": { "schema": "WeeklyStreakConfig", "description": "Weekly streak rewards" },
    "/match_scores/{duelId}": { "schema": "MatchScore", "description": "Scores for individual duels linked to a match" }
  }
}
