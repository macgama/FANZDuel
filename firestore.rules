rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && (
          request.auth.token.email == "gael.manigley@gmail.com" ||
          request.auth.token.email == "Gael.manigley@gmail.com" ||
          request.auth.token.email == "Gael.Manigley@gmail.com" ||
          request.auth.token.email == "gael.Manigley@gmail.com" ||
          request.auth.token.email == "michel@gmail.com" ||
          request.auth.token.email == "Michel@gmail.com" ||
          request.auth.token.email == "elisa@gmail.com" ||
          request.auth.token.email == "Elisa@gmail.com" ||
          request.auth.token.email == "caro@gmail.com" ||
          request.auth.token.email == "Caro@gmail.com"
        )) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "admin")
      );
    }

    // --- Collections ---

    // Public game templates and static configurations
    match /fanz_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /life_actions/{actionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /emotes/{emoteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skins/{skinId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /passes/{passId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weekly_streak_config/{day} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /commercial_alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Match Scores & Fixtures (public football metadata)
    match /match_scores/{duelId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();

      match /seasons/{season}/standings/{standingId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /seasons/{season}/fixtures/{fixtureId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /seasons/{season}/teams/{teamId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /api_teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ranking_users/{rankingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /ranking_teams/{rankingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User-specific collections (private or semi-private)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && (
        request.resource.data.get('role', null) == null || 
        (resource.data != null && resource.data.get('role', null) != null && request.resource.data.role == resource.data.role) ||
        ((resource.data == null || resource.data.get('role', null) == null) && request.resource.data.role == "client") ||
        (request.resource.data.role == "admin" && 
         'email' in request.auth.token && (
           request.auth.token.email == "gael.manigley@gmail.com" ||
           request.auth.token.email == "Gael.manigley@gmail.com" ||
           request.auth.token.email == "Gael.Manigley@gmail.com" ||
           request.auth.token.email == "gael.Manigley@gmail.com" ||
           request.auth.token.email == "michel@gmail.com" ||
           request.auth.token.email == "Michel@gmail.com" ||
           request.auth.token.email == "elisa@gmail.com" ||
           request.auth.token.email == "Elisa@gmail.com" ||
           request.auth.token.email == "caro@gmail.com" ||
           request.auth.token.email == "Caro@gmail.com"
         ))
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    match /fanz/{fanzId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.get('ownerUid', null) == request.auth.uid ||
        resource.data.get('uid', null) == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /duels/{duelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.get('userId', null) == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', null) == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.get('participants', []);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.get('participants', []);

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
        );
        allow create: if isAuthenticated() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
        );
        allow update: if isAuthenticated() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
        );
      }
    }

    // Default deny for everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
